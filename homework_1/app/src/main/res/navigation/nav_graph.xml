<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.SummerPractice2025.homework_1.fragments.MainFragment"
        android:label="Главный экран"
        tools:layout="@layout/fragment_main">

        <action
            android:id="@+id/action_main_to_second"
            app:destination="@id/secondFragment" />
    </fragment>

    <fragment
        android:id="@+id/secondFragment"
        android:name="com.example.SummerPractice2025.homework_1.fragments.SecondFragment"
        android:label="Проверка данных"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_second_to_third"
            app:destination="@id/thirdFragment" />

        <argument
            android:name="email"
            app:argType="string" />

        <argument
            android:name="password"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/thirdFragment"
        android:name="com.example.SummerPractice2025.homework_1.fragments.ThirdFragment"
        android:label="Результат"
        tools:layout="@layout/fragment_third">

        <argument
            android:name="email"
            app:argType="string" />

        <argument
            android:name="password"
            app:argType="string" />
    </fragment>



</navigation>